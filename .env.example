# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
INSTITUTION_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://trade_tuter:change-me@localhost:5432/trade_tuter?schema=public

# Authentication (use a generated 48+ character secret in production)
AUTH_SECRET=replace-with-at-least-32-characters

# Local adapters. Production readiness requires s3, streaming, and transactional.
STORAGE_PROVIDER=local
VIDEO_PROVIDER=mock
EMAIL_PROVIDER=log

# Public Vercel Blob (set STORAGE_PROVIDER=blob in Vercel; the connected
# Blob store creates this token automatically)
BLOB_READ_WRITE_TOKEN=

# Production S3-compatible private storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional invitation email. The payload is compatible with Resend's
# HTTPS API; other providers may be used if they accept the same JSON shape.
# Set EMAIL_PROVIDER=transactional above when these values are configured.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_TOKEN=
EMAIL_FROM=invites@example.com

# Gmail SMTP alternative. Enable 2-Step Verification on the Google account,
# create an App Password, and set EMAIL_PROVIDER=gmail above. Never use the
# normal Gmail account password here. EMAIL_FROM may be left blank for Gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Production monitoring/alert webhook
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=

# Authenticates scheduled internal delivery jobs
CRON_SECRET=
